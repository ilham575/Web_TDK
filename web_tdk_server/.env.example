# Database Configuration
DATABASE_URL=mysql+pymysql://username:password@localhost/tadika_db
MYSQL_ROOT_PASSWORD=local_root_password_change_me
MYSQL_DATABASE=web_tdk_db
MYSQL_USER=web_tdk_app
MYSQL_PASSWORD=local_app_password_change_me

# For Google Cloud SQL MySQL:
# DATABASE_URL=mysql+pymysql://user:password@/db?unix_socket=/cloudsql/project:region:instance

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_COOKIE_NAME=access_token
JWT_COOKIE_SECURE=auto
JWT_COOKIE_SAMESITE=lax
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# One-time bootstrap protection for dangerous setup endpoints
# Leave unset to disable /init-database and /create-owner-user over HTTP.
BOOTSTRAP_ADMIN_TOKEN=replace-with-a-random-bootstrap-token

# For cross-origin production deployments (e.g. Firebase -> Cloud Run), use:
# JWT_COOKIE_SECURE=true
# JWT_COOKIE_SAMESITE=none

# Application Settings
DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Storage
# auto  -> try GCS first, then fallback to local uploads/logos (recommended for local Docker/dev)
# local -> always store uploaded logos under uploads/logos
# gcs   -> require GCS; uploads fail if bucket/credentials are not configured
FILE_STORAGE_BACKEND=auto
LOCAL_UPLOAD_DIR=uploads/logos

# Optional GCS settings (needed when FILE_STORAGE_BACKEND=gcs or when auto should use GCS)
# GCS_BUCKET_NAME=your-public-bucket-name
# GOOGLE_APPLICATION_CREDENTIALS=/app/.gcp/service-account.json

# Production CORS Origins (comma-separated)
# CORS_ORIGINS=https://your-frontend-domain.com,https://another-domain.com

# Database connection example:
# For local MySQL: mysql+pymysql://root:password@localhost/tadika_db
# For remote MySQL: mysql+pymysql://user:pass@host:port/database
# For Cloud SQL: mysql+pymysql://user:pass@/db?unix_socket=/cloudsql/project:region:instance

# Generate a secure secret key using:
# python -c "import secrets; print(secrets.token_urlsafe(32))"